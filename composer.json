{
	"name": "storepress/marquee-block",
	"description": "Marquee Block",
	"license": "GPL-2.0-or-later",
	"version" : "2.1.0",
	"type": "wordpress-plugin",
	"keywords": [
		"gutenberg",
		"wordpress",
		"storepress",
		"plugin"
	],
	"minimum-stability" : "dev",
	"prefer-stable" : true,
	"homepage": "https://github.com/EmranAhmed/marquee-block#readme",
	"authors": [
		{
			"name": "EmranAhmed",
			"email": "emran.bd.08@gmail.com"
		},
		{
			"name": "StorePress",
			"email": "storepresshq@gmail.com"
		}
	],
	"require": {
		"storepress/admin-utils" : "^3.9.0",
		"automattic/jetpack-autoloader" : "^v5.0.20"
	},
	"require-dev": {
		"automattic/vipwpcs": "^3.1.0",
		"dealerdirect/phpcodesniffer-composer-installer": "^v1.2.1",
		"php-stubs/woocommerce-stubs": "^v10.8.1",
		"phpcompatibility/php-compatibility": "9.3.5",
		"phpcompatibility/phpcompatibility-wp": "^2.1.8",
		"phpstan/extension-installer": "^1.4.3",
		"phpstan/phpstan": "^2.2.9",
		"plugin-check/phpcs-sniffs": "@dev",
		"squizlabs/php_codesniffer": "3.13.6",
		"szepeviktor/phpstan-wordpress": "^v2.0.3",
		"woocommerce/woocommerce-sniffs": "^2.0.0",
		"wp-cli/i18n-command": "^v3.0.0",
		"wp-coding-standards/wpcs": "^3.4.1"
	},
	"repositories": [
		{
			"type" : "path",
			"url" : "./wp-plugin-check/plugin-check/phpcs-sniffs",
			"options" : {
				"symlink" : true
			}
		}
	],
	"autoload": {
		"psr-4": {
			"StorePress\\MarqueeBlock\\": "includes/"
		}
	},
	"config": {
		"optimize-autoloader" : true,
		"sort-packages" : true,
		"lock" : false,
		"platform" : {
			"php" : "7.4"
		},
		"allow-plugins" : {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"automattic/jetpack-autoloader": true,
			"phpstan/extension-installer": true
		}
	},
	"scripts": {
		"phpstan" : "./vendor/bin/phpstan --memory-limit=4G",
		"phpstan-report" : "./vendor/bin/phpstan --memory-limit=4G -vvv > phpstan-report.txt",
		"phpstan-clear" : "./vendor/bin/phpstan clear-result-cache",
		"format" : "./vendor/bin/phpcbf --standard=phpcs.xml",
		"lint-report" : "./vendor/bin/phpcs --standard=phpcs.xml --report-summary --report-source --ignore-annotations --report-full=phpcs-report.txt",
		"lint" : "./vendor/bin/phpcs --standard=phpcs.xml --report=full"
	}
}
